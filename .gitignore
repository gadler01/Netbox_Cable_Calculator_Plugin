# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
venv/
.venv/

# JS build
ui/node_modules/

# calculator.bundle.js is intentionally committed: it's the build output
# consumed at runtime, and NetBox hosts generally don't have Node available
# to build it during `pip install`. Run `npm run build` in ui/ and commit
# the result whenever ui/src changes — see README.

# Layout data (runtime-generated, not source)
netbox_cable_calc/layouts/*.json

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Gunicorn / runtime
*.pid
*.log
